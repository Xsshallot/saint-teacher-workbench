{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "saint/student/v1",
  "title": "学员档案",
  "type": "object",
  "required": ["nickname"],
  "properties": {
    "id": { "type": "integer", "description": "主键" },
    "nickname": { "type": "string", "description": "群昵称（唯一标识）" },
    "real_name": { "type": ["string", "null"], "description": "真实姓名" },
    "class_name": { "type": "string", "default": "主线班", "description": "班级（v1 单教师多班级）" },
    "avatar_hue": { "type": "integer", "minimum": 0, "maximum": 359 },
    "focus_areas": { "type": "array", "items": { "type": "string" }, "description": "主攻方向：AI 视频/图像、内容创作、金融、FDE 交付、应用开发、学习与知识" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "background": { "type": ["string", "null"], "description": "当前身份/在做什么" },
    "mbti": { "type": ["string", "null"] },
    "daily_hours": { "type": ["string", "null"], "description": "每日可投入时间" },
    "long_term_goal": { "type": ["string", "null"], "description": "长期规划（AI 方向）" },
    "first_seen": { "type": ["string", "null"], "format": "date-time" },
    "last_active": { "type": ["string", "null"], "format": "date-time" },
    "activity_count": { "type": "integer", "minimum": 0 }
  }
}
