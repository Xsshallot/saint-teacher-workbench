<Slide style={{ width: 1280, height: 720, background: '#0B1220', flexDirection: 'column', padding: '28px 60px 0' }}>
  <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#F8FAFC' }}>数据中枢：每天陪伴我的教学工作台</Text>
  <Text style={{ fontSize: 15, color: '#64748B', marginTop: 6 }}>本地优先 · SQLite 数据不出本机 · 网页即开即用</Text>

  <Box style={{ flexDirection: 'row', gap: 26, marginTop: 28 }}>
    <Image src="assets/shot-dashboard.jpg" style={{ width: 700, height: 394, borderRadius: 12, border: '1px solid #1E3A5F', objectFit: 'cover' }} />
    <Box style={{ flex: 1, flexDirection: 'column', gap: 14 }}>
      {[
        { t: '学员 360°', d: '档案/提交/卡点/愿望/时间线' },
        { t: '作业看板', d: '提交率、迟交标记、明细速览' },
        { t: '纪要知识库', d: '全部课的纪要全文检索' },
        { t: '满意度 / NPS', d: '评分趋势与分群实时可见' },
      ].map((x) => (
        <Box key={x.t} style={{ background: 'rgba(16,26,46,0.9)', border: '1px solid #1E3A5F', borderRadius: 12, padding: '20px 20px' }}>
          <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#7DD3FC' }}>{x.t}</Text>
          <Text style={{ fontSize: 13.5, color: '#94A3B8', marginTop: 4 }}>{x.d}</Text>
        </Box>
      ))}
    </Box>
  </Box>

  <Box style={{ flexDirection: 'row', gap: 16, marginTop: 22 }}>
    {[
      { n: '48', l: '学员' }, { n: '21', l: '近 30 天活跃' }, { n: '104', l: '愿望' }, { n: '4.5', l: '满意度' }, { n: '100', l: 'NPS' },
    ].map((s) => (
      <Box key={s.l} style={{ flex: 1, alignItems: 'center', padding: '10px 0', borderRadius: 10, background: 'rgba(16,26,46,0.9)', border: '1px solid #1E3A5F' }}>
        <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#FBBF24', fontFamily: 'JetBrains Mono, Consolas' }}>{s.n}</Text>
        <Text style={{ fontSize: 12.5, color: '#94A3B8', marginTop: 2 }}>{s.l}</Text>
      </Box>
    ))}
  </Box>
</Slide>
